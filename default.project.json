{
  "name": "MuseumTycoon",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 15.5,
        "Brightness": 2.5,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6,
        "Ambient": [0.27, 0.25, 0.22],
        "OutdoorAmbient": [0.55, 0.5, 0.45]
      }
    }
  }
}
